# Backblaze Drive Stats Iceberg table on B2. The public read-only values are
# on Backblaze's Drive Stats page and its "Iceberg on B2" post:
# https://www.backblaze.com/cloud-storage/resources/hard-drive-test-data
# https://www.backblaze.com/blog/iceberg-on-backblaze-b2/
B2_ENDPOINT=s3.<region>.backblazeb2.com
B2_REGION=<region>
B2_BUCKET=<bucket>
B2_PREFIX=<path/to/iceberg/table>
B2_KEY_ID=<key-id>
B2_APP_KEY=<application-key>

# Pipeline settings (defaults shown)
DATA_DIR=data
NULL_RATE_MAX_JUMP=0.05
WEEKLY_CAPACITY=50
NEG_SAMPLE_RATE=0.05

# Workers (Railway). Local: values from `supabase status` (API URL, service_role key).
# Hosted: Supabase dashboard > Project Settings > API.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Nightly job (`halflife nightly`): first month to ingest when the volume is empty,
# sample size, optional Slack incoming-webhook for alerts. Railway also needs RAILWAY_RUN_UID=0.
INGEST_START=2024-01-01
SAMPLE_PCT=10
SLACK_WEBHOOK_URL=
RAILWAY_RUN_UID=0

# Web (Vercel; locally put these in web/.env.local). Anon key only, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Shows "Demo" buttons on /login; must match the password in supabase/seed.sql.
DEMO_PASSWORD=halflife-demo
