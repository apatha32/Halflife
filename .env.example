# Backblaze Drive Stats Iceberg table on B2. The public read-only values are
# on Backblaze's Drive Stats page and its "Iceberg on B2" post:
# https://www.backblaze.com/cloud-storage/resources/hard-drive-test-data
# https://www.backblaze.com/blog/iceberg-on-backblaze-b2/
B2_ENDPOINT=s3.<region>.backblazeb2.com
B2_REGION=<region>
B2_BUCKET=<bucket>
B2_PREFIX=<path/to/iceberg/table>
B2_KEY_ID=<key-id>
B2_APP_KEY=<application-key>

# Pipeline settings (defaults shown)
DATA_DIR=data
NULL_RATE_MAX_JUMP=0.05
HORIZON_DAYS=30
WEEKLY_CAPACITY=50
NEG_SAMPLE_RATE=0.05

# Workers (Railway). Local: values from `supabase status` (API URL, service_role key).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Web (Vercel)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
